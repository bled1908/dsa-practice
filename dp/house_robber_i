"""
Problem: House Robber
Platform: LeetCode
Link: https://leetcode.com/problems/house-robber/
Difficulty: Medium
Tags: Dynamic Programming

Description:
You are a professional robber planning to rob houses along a street. Each house 
has a certain amount of money stashed, the only constraint stopping you from 
robbing each of them is that adjacent houses have security systems connected 
and it will automatically contact the police if two adjacent houses are broken 
into on the same night.

Given an integer array nums representing the amount of money of each house, 
return the maximum amount of money you can rob tonight without alerting the police.

Constraints:
- 1 <= nums.length <= 100
- 0 <= nums[i] <= 400

Approach (Top-Down DP with Memoization):
1. Define a recursive function `totalAmount(n)` → maximum money from houses [0..n].
2. At each house `n`:
   - Option 1: Rob house `n` → gain `nums[n]` + solve for `n-2`.
   - Option 2: Skip house `n` → solve for `n-1`.
3. Use memoization (`dp`) to avoid recomputation of overlapping subproblems.
4. Return the maximum between robbing and skipping for the last house.

Time Complexity: O(n)  
Space Complexity: O(n) for the memoization array.
"""

from typing import List

class Solution:
    def totalAmount(self, n, nums, dp):
        if n < 0:
            return 0
        if dp[n] != -1:
            return dp[n]

        # Case 1: Rob current house → move to n-2
        rob = nums[n] + self.totalAmount(n - 2, nums, dp)

        # Case 2: Skip current house → move to n-1
        skip = self.totalAmount(n - 1, nums, dp)

        dp[n] = max(rob, skip)
        return dp[n] 

    def rob(self, nums: List[int]) -> int:
        n = len(nums)
        dp = [-1] * (n + 1)  # memoization array
        return self.totalAmount(n - 1, nums, dp)


# Example usage & tests
if __name__ == "__main__":
    sol = Solution()
    print(sol.rob([1,2,3,1]))     # Expected: 4 (rob house 1 and 3)
    print(sol.rob([2,7,9,3,1]))   # Expected: 12 (rob house 1, 3, and 5)
    print(sol.rob([2,1,1,2]))     # Expected: 4 (rob house 1 and 4)